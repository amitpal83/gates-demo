# Copy this file to litellm/.env and fill in real values before running:
#   docker compose -f litellm/docker-compose.yml up -d
# (litellm/.env itself should stay untracked -- add it to .gitignore if not
# already covered by a repo-wide ".env" rule.)

# Primary model deployment -- same key already used by the rest of gates_ai_lld.
OPENAI_API_KEY=sk-...

# Fallback deployment -- a Google AI Studio key (used with the gemini/... model prefix).
GEMINI_API_KEY=...

# Admin key for the proxy's own API: creating virtual keys, querying spend/budget.
LITELLM_MASTER_KEY=sk-litellm-master-change-me

# Postgres password for the proxy's virtual-key/spend database.
POSTGRES_PASSWORD=change-me

# Optional: omit both to skip the gateway-side Langfuse trace.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
