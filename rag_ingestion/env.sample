# Copy this file to rag_ingestion/.env and fill in real values before
# running `docker compose -f rag_ingestion/docker-compose.yml up -d`.
# Do not commit the resulting .env file.
#
# See rag_ingestion/README.md for the full walkthrough. Quick reference for
# which values go where:
#   - Secrets this stack owns (generate fresh, don't reuse elsewhere):
#     MINIO_ROOT_PASSWORD, AIRFLOW_POSTGRES_PASSWORD, AIRFLOW_API_PASSWORD,
#     AIRFLOW_FERNET_KEY, AIRFLOW_WEBSERVER_SECRET_KEY,
#     RAG_WEBHOOK_SHARED_SECRET.
#   - Copied from the root .env (gates_ai_lld/.env), same value: OPENAI_API_KEY,
#     LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY, LANGFUSE_HOST.
#   - Needs an external account: LLAMA_CLOUD_API_KEY
#     (https://cloud.llamaindex.ai).

# ---------------------------------------------------------------------------
# MinIO (raw PDF landing zone)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
# Generate: openssl rand -hex 24
# This port is exposed to all interfaces (see docker-compose.yml header
# comment) -- a weak password here is a real exposure, not just a POC nit.
MINIO_ROOT_PASSWORD=changeme-generate-with-openssl-rand-hex-24
MINIO_BUCKET=gates-rag-docs

# ---------------------------------------------------------------------------
# Airflow
# ---------------------------------------------------------------------------
# Generate: openssl rand -hex 24
AIRFLOW_POSTGRES_PASSWORD=changeme-generate-with-openssl-rand-hex-24

# Fernet key encrypts connection/variable secrets in Airflow's metadata DB.
# This is NOT an openssl-hex value -- it must be a valid Fernet key. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=changeme-generate-with-python-cryptography-fernet

# Generate: openssl rand -hex 24
AIRFLOW_WEBSERVER_SECRET_KEY=changeme-generate-with-openssl-rand-hex-24

# Airflow UI / REST API admin login, created by the airflow-init service on
# first boot.
AIRFLOW_API_USERNAME=admin
# Generate: openssl rand -hex 24
AIRFLOW_API_PASSWORD=changeme-generate-with-openssl-rand-hex-24

# ---------------------------------------------------------------------------
# rag-webhook (internal MinIO -> Airflow trigger service)
# ---------------------------------------------------------------------------
# Generate: openssl rand -hex 24
RAG_WEBHOOK_SHARED_SECRET=changeme-generate-with-openssl-rand-hex-24

# ---------------------------------------------------------------------------
# Copied from the root .env (gates_ai_lld/.env) -- same values, not new ones
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------------------------------------------------------------------------
# LlamaParse -- needs an account at https://cloud.llamaindex.ai
# ---------------------------------------------------------------------------
LLAMA_CLOUD_API_KEY=

# ---------------------------------------------------------------------------
# Environment tag (dev/staging/production) -- forwarded to gates_ai_common
# for env-specific behavior; leave as development for local/POC use.
# ---------------------------------------------------------------------------
GATES_ENV=development
