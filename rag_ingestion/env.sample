# Copy to rag_ingestion/.env and fill in real values (do not commit .env) -- see rag_ingestion/README.md.

# -- MinIO --
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme-generate-with-openssl-rand-hex-24
MINIO_BUCKET=gates-rag-docs

# -- Airflow --
AIRFLOW_POSTGRES_PASSWORD=changeme-generate-with-openssl-rand-hex-24

# Must be a real Fernet key, not hex -- generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=changeme-generate-with-python-cryptography-fernet

AIRFLOW_WEBSERVER_SECRET_KEY=changeme-generate-with-openssl-rand-hex-24
AIRFLOW_API_USERNAME=admin
AIRFLOW_API_PASSWORD=changeme-generate-with-openssl-rand-hex-24

# -- rag-webhook --
RAG_WEBHOOK_SHARED_SECRET=changeme-generate-with-openssl-rand-hex-24

# -- Copied from the root .env (same values, not new ones) --
OPENAI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# -- LlamaParse: https://cloud.llamaindex.ai --
LLAMA_CLOUD_API_KEY=

GATES_ENV=development
